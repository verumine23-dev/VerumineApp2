<?xml version="1.0" encoding="utf-8"?>
<ScrollView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_neon_gradient"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mes appareils"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gérez vos devices et votre puissance"
            android:textColor="#A099C4"
            android:textSize="12sp" />

        <!-- Appareil 1 : PC Bureau -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:id="@+id/d1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PC - Bureau" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_below="@id/d1" android:text="● En ligne • 12.4 MH/s" android:textColor="#00E676" android:textSize="12sp" />
                <Switch android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:checked="true" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Appareil 2 : Samsung Galaxy A54 (Smartphone) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:id="@+id/d2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Samsung Galaxy A54" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_below="@id/d2" android:text="● En ligne • 1.2 MH/s" android:textColor="#00E676" android:textSize="12sp" />
                <Switch android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:checked="true" />
            </RelativeLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>