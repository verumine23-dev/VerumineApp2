<?xml version="1.0" encoding="utf-8"?>
<ScrollView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_neon_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Créer un compte"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:text="Rejoignez la communauté Verumine"
            android:textColor="#A099C4"
            android:textSize="14sp" />

        <!-- Champs de saisie -->
        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_dark"
            android:hint="Nom complet"
            android:padding="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#A099C4" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_dark"
            android:hint="Adresse email"
            android:inputType="textEmailAddress"
            android:padding="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#A099C4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_card_dark"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="🇧🇯 +229"
                android:textColor="#FFFFFF" />

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_card_dark"
                android:hint="Numéro de téléphone"
                android:inputType="phone"
                android:padding="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#A099C4" />
        </LinearLayout>

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_dark"
            android:hint="Mot de passe (min 8 caractères)"
            android:inputType="textPassword"
            android:padding="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#A099C4" />

        <EditText
            android:id="@+id/etReferral"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_card_dark"
            android:hint="Code de parrainage (optionnel)"
            android:padding="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#A099C4" />

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/bg_button_gradient"
            android:text="Créer mon compte >"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGoToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:text="Déjà un compte ? Se connecter"
            android:textColor="#00F5D4" />

    </LinearLayout>
</ScrollView>